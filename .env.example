# Variables attendues par apps/site et apps/admin. À poser dans Vercel sur chacun des deux
# projets (tous environnements). En local : copier ce fichier en .env.local dans chaque app.
#
# Les deux sont publiques par conception : elles partent dans le navigateur. La sécurité tient
# aux politiques RLS. La clé service_role ne figure ni ici, ni nulle part dans le dépôt.

NEXT_PUBLIC_SUPABASE_URL=https://ybcdppcdgbbujmlmimqs.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Comptes du back-office, base locale seulement ──────────────────────────────
# Mot de passe des comptes créés par `supabase/seed.sql`
# (decisions/2026-11-10-authentification.md). Ce n'est PAS une variable des apps : elle ne part
# ni dans Vercel ni dans le navigateur. Elle ne sert qu'à poser le réglage de la base locale,
# une fois par base (le réglage survit à `supabase db reset`) :
#
#   psql "$(supabase status -o json | jq -r .DB_URL)" \
#     -c "alter role postgres set siempass.mot_de_passe = '$SIEMPASS_MOT_DE_PASSE_ADMIN'"
#
# Non posée : le seed ne crée aucun compte et le dit. C'est le cas de la CI.
SIEMPASS_MOT_DE_PASSE_ADMIN=
